{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/hippocampal_pyramidal.h5ad",
    "spatial_key": "spatial",
    "use_raw": false,
    "min_cells_per_gene": 1,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "log1p": false,
    "max_cells": null,
    "seed": 0,
    "q": 10
  },
  "test": {
    "method": "parallel_permutation",
    "metric": "nll_gaussian_mse",
    "n_perms": 999,
    "epochs": 500,
    "n_reruns": 30,
    "sgd_batch_size": 256,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "verbose": true
  },
  "output": {
    "out_dir": "results",
    "run_name": "hippocampus_existence",
    "save_preds": false,
    "save_perm_stats": true
  }
}
