{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/merfish_xia2019_u2os.h5ad",
    "spatial_key": "spatial",
    "min_cells_per_gene": 1,
    "min_cells_per_celltype": 5,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "normalize_total": true,
    "log1p": true,
    "use_raw": false,
    "seed": 0
  },
  "test": {
    "method": "visium_pseudobulk",
    "metric": "nll_gaussian_mse",
    "n_perms": 99,
    "epochs": 1000,
    "n_reruns": 30,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "linear",
    "verbose": true,
    "coordinate_um_per_unit": 1.0,
    "visium_spot_distance_um": 100.0,
    "visium_spot_diameter_um": 55.0,
    "block_jitter": false
  },
  "output": {
    "out_dir": "results/jfan_merfish",
    "run_name": "260825_jfan_merfish_visium_pseudobulk",
    "save_preds": false,
    "save_perm_stats": true
  }
}
