{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/merfish_hypothalamus.h5ad",
    "spatial_key": "spatial",
    "obs_x_col": null,
    "obs_y_col": null,
    "layer": null,
    "use_raw": false,
    "min_cells_per_gene": 1,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "log1p": true,
    "max_cells": null,
    "seed": 0
  },
  "test": {
    "method": "parallel_permutation",
    "metric": "nll_gaussian_mse",
    "covariate": "midline",
    "n_perms": 99,
    "epochs": 500,
    "n_reruns": 30,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "quadratic",
    "verbose": true
  },
  "output": {
    "out_dir": "results",
    "run_name": "hypothalamus_existence_quadratic",
    "save_preds": false,
    "save_perm_stats": true
  }}
