{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/merfish_hypothalamus.h5ad",
    "spatial_key": "spatial",
    "obs_x_col": null,
    "obs_y_col": null,
    "layer": null,
    "use_raw": false,
    "min_cells_per_gene": 1,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "log1p": true,
    "max_cells": null,
    "seed": 0,
    "top_var_genes": 3000
  },
  "test": {
    "method": "parallel_permutation",
    "metric": "nll_gaussian_mse",
    "n_perms": 99,
    "epochs": 500,
    "n_reruns": 10,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "linear",
    "recursive": true,
    "alpha": 0.05,
    "max_gradients": 10,
    "verbose": true
  },
  "output": {
    "out_dir": "results",
    "run_name": "hypothalamus_recursive",
    "save_preds": false,
    "save_perm_stats": true
  }
}
