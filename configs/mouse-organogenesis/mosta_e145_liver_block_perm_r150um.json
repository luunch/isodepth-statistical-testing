{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/mouse-organogenesis/E14.5_E1S1.MOSTA.h5ad",
    "spatial_key": "spatial",
    "layer": "count",
    "obs_filters": {"annotation": "Liver"},
    "obs_drop_na": ["annotation"],
    "top_var_genes": 1000,
    "min_cells_per_gene": 3,
    "max_cells": null,
    "seed": 42,
    "normalize_total": true,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "log1p": true
  },
  "test": {
    "method": "block_permutation",
    "metric": "nll_gaussian_mse",
    "covariate": null,
    "block_radius": 150,
    "coordinate_um_per_unit": 25.0,
    "block_jitter": true,
    "n_perms": 99,
    "epochs": 500,
    "n_reruns": 10,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "patience": 50,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "verbose": true
  },
  "output": {
    "out_dir": "results/mouse-organogenesis",
    "run_name": "mosta_e145_liver_block_perm_r150um",
    "save_preds": false,
    "save_perm_stats": true
  }
}
