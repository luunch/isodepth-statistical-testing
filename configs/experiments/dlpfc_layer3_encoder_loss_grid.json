{
  "experiment_name": "dlpfc_layer3_encoder_loss_grid",
  "description": "DLPFC Layer 3 DBSCAN middle region: three matched 500-epoch encoder pretrain paths, then freeze encoder and train decoder-only for 500 epochs under Gaussian MSE or Poisson NLL (SGD-128).",
  "plot_title": "DLPFC Layer 3 middle region — encoder source × decoder loss",
  "data": {
    "parent_h5ad": "data/h5ad/dlpfc_new/spatialDLPFC_Visium.h5ad",
    "prepared_h5ad": "data/h5ad/dlpfc_new/layer3_br6522_ant_1000hvg_gaussian_isodepth.h5ad",
    "obs_filters": {"sample_id": "Br6522_ant"},
    "obs_drop_na": ["manual_layer_label"],
    "layer_label": "Layer 3",
    "layer_obs_key": "manual_layer_label",
    "top_var_genes": 1000,
    "covariate_obs_key": "gaussian_isodepth"
  },
  "spatial_subset": {
    "mode": "dbscan_middle",
    "axis": "pc1",
    "eps": null,
    "eps_mult": 3.0,
    "min_samples": 10,
    "min_cells": 50
  },
  "preprocessing": {
    "min_cells_per_gene": 3,
    "normalize_total": false,
    "log1p": false,
    "standardize_expression": false,
    "standardize_coordinates": true
  },
  "schedule": {
    "pretrain_epochs": 500,
    "warm_gaussian_epochs": 100,
    "decoder_epochs": 500,
    "n_reruns": 100,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "decoder": "nn",
    "seed": 42,
    "device": "cuda"
  },
  "output": {
    "out_dir": "results/dlpfc_new",
    "run_name": "layer3_encoder_loss_grid_middle_band"
  }
}
