{
    "data": {
        "source": "h5ad",
        "h5ad": "data/h5ad/hippocampal_pyramidal_CA_midline.h5ad",
        "spatial_key": "spatial",
        "cell_type": "separate",
        "cell_type_key": "cell_type",
        "use_raw": false,
        "min_cells_per_gene": 1,
        "standardize_expression": true,
        "standardize_coordinates": true,
        "log1p": true,
        "max_cells": null,
        "top_var_genes": 3000,
        "seed": 42
    },
    "test": {
      "method": "parallel_permutation",
      "metric": "nll_gaussian_mse",
      "n_perms": 99,
      "epochs": 500,
      "n_reruns": 10,
      "sgd_batch_size": 128,
      "lr": 0.001,
      "seed": 42,
      "device": "cuda",
      "decoder": "quadratic",
      "recursive": true,
      "alpha": 0.05,
      "max_gradients": 10,
      "verbose": true
    },
    "output": {
      "out_dir": "results",
      "run_name": "hippocampus_recursive",
      "save_preds": false,
      "save_perm_stats": true
    }
  }
  