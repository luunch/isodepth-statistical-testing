{
    "data": {
      "source": "h5ad",
      "h5ad": "data/h5ad/hippocampal_pyramidal_CA_morphogam_midline.h5ad",
      "spatial_key": "spatial",
      "use_raw": false,
      "min_cells_per_gene": 3,
      "standardize_expression": true,
      "standardize_coordinates": true,
      "normalize_total": true,
      "log1p": true,
      "max_cells": null,
      "top_var_genes": 3000,
      "seed": 42
    },
    "test": {
      "method": "parallel_permutation",
      "metric": "nll_gaussian_mse",
      "covariate": "coordinate",
      "n_perms": 999,
      "epochs": 500,
      "n_reruns": 10,
      "sgd_batch_size": 128,
      "lr": 0.001,
      "seed": 42,
      "device": "cuda",
      "decoder": "nn",
      "verbose": true
    },
    "output": {
      "out_dir": "results",
      "run_name": "hippocampus_existence_top_3000_genes",
      "save_preds": false,
      "save_perm_stats": true
    }
  }  