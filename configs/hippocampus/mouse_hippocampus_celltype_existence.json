{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/hippocampal_pyramidal_CA_morphogam_midline.h5ad",
    "spatial_key": "spatial",
    "cell_type": "separate",
    "cell_type_key": "cell_type",
    "use_raw": false,
    "min_cells_per_gene": 1,
    "standardize_expression": true,
    "normalize_total": true,
    "standardize_coordinates": true,
    "log1p": true,
    "max_cells": null,
    "seed": 42,
    "top_var_genes": 1000
  },
  "test": {
    "method": "parallel_permutation",
    "metric": "nll_gaussian_mse",
    "covariate": "coordinate",
    "n_perms": 999,
    "epochs": 500,
    "n_reruns": 10,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "verbose": true
  },
  "output": {
    "out_dir": "results/hippocampus",
    "run_name": "gaussian_separate_cells",
    "save_preds": false,
    "save_perm_stats": true
  }
}
