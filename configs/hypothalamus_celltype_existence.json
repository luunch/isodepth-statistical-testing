{
  "data": {
    "source": "h5ad",
    "h5ad": "data/h5ad/merfish_hypothalamus_rctd.h5ad",
    "spatial_key": "spatial",
    "cell_type": "separate",
    "cell_type_key": "dominant_cell_type",
    "min_cells_per_gene": 1,
    "min_cells_per_celltype": 5,
    "standardize_expression": true,
    "standardize_coordinates": true,
    "log1p": true,
    "use_raw": false,
    "seed": 0
  },
  "test": {
    "method": "parallel_permutation",
    "metric": "nll_gaussian_mse",
    "n_perms": 999,
    "epochs": 500,
    "n_reruns": 30,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "patience": 0,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "verbose": true
  },
  "output": {
    "out_dir": "results",
    "run_name": "hypothalamus_separated_celltype_128sgd_batch_size_500epochs",
    "save_preds": false,
    "save_perm_stats": true
  }
}
