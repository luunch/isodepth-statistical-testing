{
  "data": {
    "source": "synthetic",
    "mode": "radial",
    "n_cells": 5000,
    "n_genes": 20,
    "shape": "square",
    "sampling_bias": {"type": "uniform"},
    "sigma": 0,
    "poly_degree": 1,
    "seed": 42
  },
  "test": {
    "method": "joint_truncated_rank_msr",
    "metric": "nll_gaussian_mse",
    "n_perms": 99,
    "epochs": 500,
    "n_reruns": 10,
    "sgd_batch_size": 128,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "batch_size": null,
    "verbose": true,
    "msr_neighbor_radius_um": 30,
    "msr_truncate_um": 20,
    "msr_calibration_um": null,
    "msr_shared_rank": false,
    "coordinate_um_per_unit": 1000.0
  },
  "output": {
    "out_dir": "results/synthetic",
    "run_name": "msr_radial_rank",
    "save_preds": false,
    "save_perm_stats": true
  }
}
