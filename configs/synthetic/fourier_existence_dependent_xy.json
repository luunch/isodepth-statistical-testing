{
  "data": {
    "source": "synthetic",
    "mode": "fourier",
    "n_cells": 1000,
    "n_genes": 10,
    "sigma": 0,
    "k_min": 1,
    "k_max": 5,
    "sampling_bias": {"type": "uniform"},
    "dependent_xy": true,
    "poly_degree": 1,
    "seed": 42
  },
  "test": {
    "method": "cross_validation",
    "n_folds": 5,
    "metric": "nll_gaussian_mse",
    "n_perms": 99,
    "epochs": 500,
    "sgd_batch_size": 128,
    "n_reruns": 10,
    "lr": 0.001,
    "seed": 42,
    "device": "cuda",
    "decoder": "nn",
    "batch_size": null,
    "verbose": true
  },
  "output": {
    "out_dir": "results",
    "run_name": "fourier_existence_dependent_xy",
    "save_preds": false,
    "save_perm_stats": true
  }
}
